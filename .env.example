# Scam Scout. Copy to .env.local. Never commit real keys.
# Hosted live checks need the two server keys below. They are optional:
# visitors can paste their own keys under Advanced. Those stay in sessionStorage,
# are sent only with that request, are not logged, and are not written here.

# --- Hosted research and models (optional if visitors bring keys) ---
TAVILY_API_KEY=
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Router, page reading, snapshot vision, memo. Ultra is optional, not the default.
MODEL_ROUTER=nvidia/Nemotron-3_5-Lightning
MODEL_EXTRACT=nvidia/nemotron-3-super-120b-a12b
MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
MODEL_JUDGE=nvidia/nemotron-3-super-120b-a12b
# MODEL_JUDGE=nvidia/Nemotron-3-Ultra-550b-a55b

# --- Auth. Required for hosted live checks in production. ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Aliases also read: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Bot check. Required for hosted live checks in production. ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Owner-only live checks. Off until LIVE_MODE_ENABLED is on. ---
# LIVE_ALLOWLIST_EMAILS is a comma-separated list of Google account emails.
LIVE_MODE_ENABLED=
LIVE_ALLOWLIST_EMAILS=
OWNER_DAILY_LIVE_CAP=

# Hard stop for provider spend, including bring-your-own keys. The ledger is Upstash only.
# Required lifetime totals that never reset.
# Blank, non-numeric or negative refuses live checks (fail closed). Zero pauses live checks.
SPEND_HARD_LIMIT_USD=
TAVILY_CREDIT_HARD_LIMIT=
# Optional daily Tavily cap and daily cap on hosted live checks. Blank means none.
TAVILY_DAILY_CREDIT_LIMIT=
GLOBAL_LIVE_DAILY_CAP=

# One shared judge login. The bcrypt hash only, never the password. Unset means no judge login.
JUDGE_USERNAME=
JUDGE_PASSWORD_HASH=

# --- Quotas. Blank names use the defaults in code. ---
ACCOUNT_QUOTA=
IP_DAILY_CAP=
DEVICE_DAILY_CAP=
RATE_LIMIT_PER_HOUR=
DAILY_CREDIT_CAP=
CREDITS_PER_LIVE_CASE=
# One-time extras, comma-separated CODE:amount
INVITE_CODES=

# Required for the spend ledger. Also shares usage caps and captures across instances.
# Without these, usage caps are per instance plus a signed cookie, and live checks stay paused.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
USAGE_DATA_FILE=

# --- Per case. Blank names use the defaults in code. ---
MAX_STEPS=
MAX_TAVILY_CREDITS=
# Hard per-check stops on live calls. Unset values use the defaults in code.
# Basic-depth searches only. A value that is not a number closes live calls for the check.
CHECK_MAX_TAVILY_CALLS=
CHECK_MAX_TAVILY_CREDITS=
CHECK_MAX_TOKENS=
MAX_WALL_SECONDS=
REPORT_RETENTION_DAYS=
MAX_TOKENS=
MAX_SCREENSHOTS=
MAX_PAGES=

# Optional snapshot worker. Vision is skipped when these are empty.
SCREENSHOT_WORKER_URL=
SCREENSHOT_SHARED_SECRET=

# auto | 3d | 2d | static
NEXT_PUBLIC_WORLD_MODE=auto
NEXT_PUBLIC_API_BASE=
